# ---------------------------------------------------------------- database
DATABASE_URL=postgresql://rampart:rampart@localhost:5433/rampart

# -------------------------------------------------------------------- http
PORT=3001
# Comma-separated origins allowed by CORS
WEB_ORIGIN=http://localhost:3000,http://localhost:3002

# ------------------------------------------------- Keycloak (OIDC — authN)
KEYCLOAK_ISSUER=http://keycloak:8080/realms/rampart
KEYCLOAK_AUDIENCE=rampart-api
# Optional: confidential client with manage-users, enables user provisioning
# on member create (unset = provisioning disabled)
# KEYCLOAK_ADMIN_CLIENT_ID=rampart-api-admin
# KEYCLOAK_ADMIN_CLIENT_SECRET=

# ------------------------------------------- object storage: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# S3_ENDPOINT=            # set for S3-compatible stores (MinIO/R2); omit for AWS
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ------------------------------------------------------ email (unset = off)
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# EMAIL_FROM="RPI Ambulance <no-reply@rpiambulance.com>"

# ------------------------------------------------------ Slack (unset = off)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_OFFICERS_CHANNEL=#officers
# SLACK_WHOSON_CHANNEL=#general

# -------------------------------------- Google Calendar sync (unset = off)
# GOOGLE_CALENDAR_ID=events@rpiambulance.com
# GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./gcal-service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON=   # alternative: inline JSON

# ------------------------------------------- legacy migration (one-shot ETL)
# LEGACY_MYSQL_URL=mysql://root:pass@localhost:3306/ambulanc_web

# --------------------------- Coolify deploy (scripts/deploy.sh, not the app)
# COOLIFY_URL=https://coolify.example.com
# COOLIFY_API_TOKEN=
# COOLIFY_APP_UUID=
# REGISTRY_IMAGE=registry.example.com/rpiambulance/rampart-api

# ICS feed UID domain (optional)
# ICS_UID_DOMAIN=rampart.rpiambulance.com

# Base URL of the web app (used in emails/status links)
WEB_BASE_URL=http://localhost:3000
# Swagger UI at /docs (set false to disable)
# SWAGGER_ENABLED=true

# ---------------------------------------------- first-admin bootstrap
# Grants a role (default "Admin") to this email on boot, creating the member
# if needed. No-op once any administrator exists, so it is safe to leave set —
# but remove it once you've signed in. The member links to Keycloak on first
# login via verified email.
# BOOTSTRAP_ADMIN_EMAIL=you@rpiambulance.com
# BOOTSTRAP_ADMIN_NAME=Your Name
# BOOTSTRAP_ADMIN_ROLE=Admin

# ------------------------------------ Cloudflare Turnstile (public forms)
# The bot check on the coverage intake form. Both halves come from one
# Turnstile widget in the Cloudflare dashboard: the secret key goes here, the
# site key goes to the web app as TURNSTILE_SITE_KEY. Unset means the check is
# skipped entirely, which the API warns about at boot.
# TURNSTILE_SECRET_KEY=

# ------------------------------------------------- DiALERT integration
# Shared secret for GET /v1/dialert/duty-supervisor?token=…, which returns
# the member ID of the night crew's duty supervisor and nothing else. Unset
# means the endpoint answers nobody — it never falls open. Use a long random
# value: `openssl rand -hex 32`.
# DIALERT_TOKEN=
