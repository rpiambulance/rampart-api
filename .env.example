# Postgres
DATABASE_URL=postgresql://rampart:rampart@localhost:5433/rampart

# HTTP
PORT=3001
WEB_ORIGIN=http://localhost:3000

# Keycloak (authN only — see spec §2)
KEYCLOAK_ISSUER=https://keycloak.rpiambulance.com/realms/rpiambulance
KEYCLOAK_AUDIENCE=rampart-api

# Object storage: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Integrations
# SLACK_BOT_TOKEN=
# GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
# GOOGLE_CALENDAR_ID=events@rpiambulance.com

# Coolify deploy (used by scripts/deploy.sh, not the app)
# COOLIFY_URL=https://coolify.example.com
# COOLIFY_API_TOKEN=
# COOLIFY_APP_UUID=
# REGISTRY_IMAGE=registry.example.com/rpiambulance/rampart-api
