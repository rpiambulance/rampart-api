// Rampart API — Prisma schema
// Spec: rpiambulance/website docs/modernization-spec.md

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Members
// ---------------------------------------------------------------------------

model Member {
  id              Int       @id @default(autoincrement())
  legacyId        Int?      @unique // members.id from the old MySQL portal
  keycloakSubject String?   @unique
  firstName       String
  lastName        String
  dob             DateTime? @db.Date
  email           String    @unique
  personalEmail   String?
  cellPhone       String?
  homePhone       String?
  localAddress    String?
  homeAddress     String?
  rcsId           String?
  /// RPI 900 number. Kept for credentialed members and officers by
  /// convention, not by rule — nothing here requires or checks it.
  nineHundredNumber String? @map("900number")
  rin             String?
  facilityId      String?
  cardId          String?
  slackId         String?   @unique
  active          Boolean   @default(true)
  navLayout       String    @default("sidebar") // UI preference: sidebar | topnav
  eventView       String    @default("list") // UI preference: list | day | week | month
  timeFormat      String    @default("24h") // UI preference: 24h | 12h
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  roles              MemberRole[]
  credentials        MemberCredential[]
  certifications     MemberCertification[]
  verifiedCerts      MemberCertification[] @relation("CertVerifier")
  evaluationsWritten Evaluation[]          @relation("Evaluator")
  evaluationsAbout   Evaluation[]          @relation("EvalSubject")
  checklistSignoffs  ChecklistSignoff[]    @relation("ChecklistSubject")
  checklistSigned    ChecklistSignoff[]    @relation("ChecklistSigner")
  checklistRevoked   ChecklistSignoff[]    @relation("ChecklistRevoker")
  promotionRequests  PromotionRequest[]
  promotionVotes     PromotionVote[]       @relation("Voter")
  proxiedVotes       PromotionVote[]       @relation("ProxyFor")
  proxyPrincipalOf   PromotionProxy[]      @relation("ProxyPrincipal")
  proxyAgentOf       PromotionProxy[]      @relation("ProxyAgent")
  requirementAdjustments PromotionRequirementAdjustment[] @relation("AdjustmentSubject")
  adjustmentsCreated     PromotionRequirementAdjustment[] @relation("AdjustmentCreator")
  crewSlots          CrewSlot[]
  eventSignups       EventSignup[]
  fuelLogEntries     FuelLogEntry[]
  radioAssignments   RadioAssignment[]
  icsTokens          IcsToken[]
  apiTokens          ApiToken[]
  annualTrainings    MemberAnnualTraining[]
  classAttendance    ClassAttendance[]
  crewAbsences       CrewAbsence[]
  pollInvites        AvailabilityPollInvite[]
  availability       AvailabilityResponse[]
  inbox              InboxMessage[]
  pollsCreated       AvailabilityPoll[]
  eventAvailability  EventAvailability[]
  coverageMessages   CoverageMessage[]
}

// ---------------------------------------------------------------------------
// RBAC: permissions catalog (string keys defined in code) -> roles -> members
// ---------------------------------------------------------------------------

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  isOfficer   Boolean          @default(false)
  permissions RolePermission[]
  members     MemberRole[]
  credentialLinks CredentialTypeRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId     Int
  permission String // key from the permission catalog (src/permissions/catalog.ts)
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
}

model MemberRole {
  id        Int       @id @default(autoincrement())
  memberId  Int
  roleId    Int
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date // null = appointed / open-ended
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([roleId])
}

// ---------------------------------------------------------------------------
// Certifications (external, expiring documents)
// ---------------------------------------------------------------------------

model CertificationType {
  id                    Int     @id @default(autoincrement())
  name                  String  @unique
  abbreviation          String
  issuingOrg            String?
  defaultValidityMonths Int? // null = non-expiring
  active                Boolean @default(true)

  memberCertifications  MemberCertification[]
  credentialRequirements CredentialRequirement[]
  requirementAdjustments PromotionRequirementAdjustment[]
  /// Certifications this one outranks, and the ones that outrank it.
  supersedes             CertificationSupersession[] @relation("Supersedes")
  supersededBy           CertificationSupersession[] @relation("SupersededBy")
}

/// Certification ranking: holding the higher one satisfies a requirement for
/// the lower. A Paramedic answers a requirement for EMT.
model CertificationSupersession {
  higherTypeId Int
  lowerTypeId  Int

  higher CertificationType @relation("Supersedes", fields: [higherTypeId], references: [id], onDelete: Cascade)
  lower  CertificationType @relation("SupersededBy", fields: [lowerTypeId], references: [id], onDelete: Cascade)

  @@id([higherTypeId, lowerTypeId])
  @@index([lowerTypeId])
}


enum CertStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

model MemberCertification {
  id              Int        @id @default(autoincrement())
  memberId        Int
  typeId          Int
  identifier      String? // cert / license number
  issuedAt        DateTime?  @db.Date
  expiresAt       DateTime?  @db.Date
  status          CertStatus @default(PENDING_VERIFICATION)
  verifiedById    Int?
  verifiedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  member     Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type       CertificationType       @relation(fields: [typeId], references: [id])
  verifiedBy Member?                 @relation("CertVerifier", fields: [verifiedById], references: [id])
  documents  CertificationDocument[]

  @@index([memberId])
  @@index([expiresAt])
}

/// Uploaded proof of a certification — licence cards, course certificates.
///
/// The id is a random UUID rather than a sequence: it addresses a file of
/// somebody's personal paperwork, and a sequential one lets anyone who can
/// open a single document walk the whole archive by counting, and read off
/// how many exist. Nothing points at these rows, so the opaque id costs
/// nothing elsewhere.
model CertificationDocument {
  id              String   @id @default(uuid(4))
  certificationId Int
  storageKey      String // key in the object store (local driver or S3)
  fileName        String
  contentType     String
  sizeBytes       Int
  uploadedAt      DateTime @default(now())

  certification MemberCertification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Credentials — progression tree (O -> A -> {A-D -> P-D -> D -> D-T | A-CC -> P-CC -> CC -> CC-T})
// CC add-ons: FR-CC, EES. DS is a captain appointment (SDS = DS with a different title).
// ---------------------------------------------------------------------------

enum GrantMethod {
  PROMOTION // TC unanimous vote + captain approval
  APPOINTMENT // captain only (DS)
}

model CredentialType {
  id          Int         @id @default(autoincrement())
  key         String      @unique // O, A, A_D, P_D, D, D_T, A_CC, P_CC, CC, CC_T, FR_CC, EES, DS
  name        String
  grantMethod GrantMethod @default(PROMOTION)
  isAddOn     Boolean     @default(false) // FR-CC, EES
  /// Satisfies every credential requirement regardless of the prerequisite
  /// graph. A Duty Supervisor outranks the whole ladder, including add-ons
  /// (FR-CC) that are not in its own prerequisite chain.
  outranksAll Boolean     @default(false)
  active      Boolean     @default(true)

  linkedRoles     CredentialTypeRole[] // roles conferred automatically while ACTIVE
  prerequisites   CredentialPrerequisite[] @relation("Prerequisites")
  prerequisiteOf  CredentialPrerequisite[] @relation("PrerequisiteOf")
  requirements    CredentialRequirement[]
  memberCredentials MemberCredential[]
  promotionRequests PromotionRequest[]
  requirementAdjustments PromotionRequirementAdjustment[]
  checklistSignoffLevel  EvalFormTemplate[] @relation("ChecklistSignoffLevel")
  checklistItemLevel     EvalFormItem[]     @relation("ChecklistItemSignoffLevel")
}

// Holding this credential ACTIVE confers the linked role's permissions
// (additive with explicitly assigned roles; suspension removes them).
model CredentialTypeRole {
  credentialTypeId Int
  roleId           Int

  credentialType CredentialType @relation(fields: [credentialTypeId], references: [id], onDelete: Cascade)
  role           Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([credentialTypeId, roleId])
}

model CredentialPrerequisite {
  credentialTypeId Int
  requiresTypeId   Int
  credentialType   CredentialType @relation("Prerequisites", fields: [credentialTypeId], references: [id], onDelete: Cascade)
  requiresType     CredentialType @relation("PrerequisiteOf", fields: [requiresTypeId], references: [id], onDelete: Cascade)

  @@id([credentialTypeId, requiresTypeId])
}

enum RequirementKind {
  CERTIFICATION // a verified, unexpired cert of certificationTypeId
  EVALUATION_COUNT // `count` signed evals on evalTemplateId
  CLASS // completion of classId
  CHECKLIST // every line of the checklist at evalTemplateId signed off
}

model CredentialRequirement {
  id                  Int             @id @default(autoincrement())
  credentialTypeId    Int
  kind                RequirementKind
  certificationTypeId Int?
  evalTemplateId      Int?
  count               Int?
  classId             Int?

  credentialType    CredentialType     @relation(fields: [credentialTypeId], references: [id], onDelete: Cascade)
  certificationType CertificationType? @relation(fields: [certificationTypeId], references: [id])
  evalTemplate      EvalFormTemplate?  @relation(fields: [evalTemplateId], references: [id])
  class             TrainingClass?     @relation(fields: [classId], references: [id])
  adjustments       PromotionRequirementAdjustment[]
}

enum CredentialStatus {
  ACTIVE
  SUSPENDED // automatic: a required cert lapsed
  REVOKED
}

model MemberCredential {
  id           Int              @id @default(autoincrement())
  memberId     Int
  typeId       Int
  status       CredentialStatus @default(ACTIVE)
  title        String? // display-title override, e.g. "Senior Duty Supervisor" on a DS credential
  grantedAt    DateTime         @default(now()) // when this row was created here
  /// When the member actually earned it. Null while unknown — a backfilled
  /// credential can be recorded now and dated later. Prefer this over
  /// grantedAt for display.
  effectiveAt  DateTime?        @db.Date
  grantedViaId Int? // PromotionRequest id; null for appointments/corrections
  revokedAt    DateTime?

  member     Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type       CredentialType    @relation(fields: [typeId], references: [id])
  grantedVia PromotionRequest? @relation(fields: [grantedViaId], references: [id])

  @@unique([memberId, typeId])
  @@index([typeId])
}

// ---------------------------------------------------------------------------
// Training: eval form templates + evaluations
// ---------------------------------------------------------------------------

enum ScoreType {
  SCALE_1_5
  PASS_FAIL
  /// Free text, several lines.
  TEXT
  /// Free text, one line.
  SHORT_TEXT
  /// A number, with optional bounds on the item.
  NUMBER
  /// A list of choices, defined on the item. Pick one.
  OPTIONS
  /// The same list, but any number of them may be picked.
  MULTI_SELECT
  /// Not a question: a heading or instruction shown on the form.
  HEADING
  /// A line on a checklist: signed off rather than answered.
  SIGNOFF
}

/// Evaluations are filled in once; checklists are signed off item by item,
/// over time, by whoever is qualified to sign each line.
enum TemplateKind {
  EVALUATION
  CHECKLIST
}

/// The evaluator's overall verdict on an evaluation.
enum EvalOutcome {
  NEEDS_IMPROVEMENT
  PASSED
}

model EvalFormTemplate {
  id        Int          @id @default(autoincrement())
  name      String
  kind      TemplateKind @default(EVALUATION)
  version   Int          @default(1)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())

  /// Checklists only: the credentials that let someone sign. Holding any one
  /// of them — or anything above it on the ladder — is enough. An item may
  /// name its own set instead.
  signoffCredentialTypes CredentialType[] @relation("ChecklistSignoffLevel")

  groups                 EvalFormGroup[]
  items                  EvalFormItem[]
  evaluations            Evaluation[]
  credentialRequirements CredentialRequirement[]
  requirementAdjustments PromotionRequirementAdjustment[]

  @@unique([name, version])
}

/// A titled run of items. Groups and loose items share one ordering space at
/// the top of a form, so a group moves exactly like a single item does.
model EvalFormGroup {
  id         Int    @id @default(autoincrement())
  templateId Int
  order      Int
  heading    String
  /// Shown under the heading, before the first item.
  description String?

  template EvalFormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    EvalFormItem[]

  @@index([templateId])
}

model EvalFormItem {
  id         Int       @id @default(autoincrement())
  templateId Int
  /// Null = loose at the top level; otherwise the group it sits in. `order`
  /// is read within whichever of the two contains it.
  groupId    Int?
  order      Int
  prompt     String
  scoreType  ScoreType
  /// For OPTIONS and MULTI_SELECT: [{ value, label }], in offer order.
  options    Json?
  /// NUMBER only: bounds and unit, all optional.
  minValue   Float?
  maxValue   Float?
  unit       String?

  template              EvalFormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  group                 EvalFormGroup?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Checklists only: who may sign this line, instead of the checklist's own
  /// set. Empty means the checklist's set applies.
  signoffCredentialTypes CredentialType[] @relation("ChecklistItemSignoffLevel")
  scores                EvalScore[]
  signoffs              ChecklistSignoff[]

  @@index([templateId])
  @@index([groupId])
}

/// One trainer putting their name to one checklist line for one trainee.
///
/// Rows are kept after revocation rather than deleted, so a checklist can
/// answer "who signed this, and did anyone take it back" — which is the whole
/// point of signing it. The live sign-off is the newest un-revoked row.
model ChecklistSignoff {
  id           Int       @id @default(autoincrement())
  memberId     Int
  itemId       Int
  signedById   Int
  signedAt     DateTime  @default(now())
  note         String?
  revokedAt    DateTime?
  revokedById  Int?
  revokeReason String?

  member    Member       @relation("ChecklistSubject", fields: [memberId], references: [id], onDelete: Cascade)
  item      EvalFormItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  signedBy  Member       @relation("ChecklistSigner", fields: [signedById], references: [id])
  revokedBy Member?      @relation("ChecklistRevoker", fields: [revokedById], references: [id])

  @@index([memberId, itemId])
  @@index([itemId])
}

enum EvalStatus {
  DRAFT
  SUBMITTED
  SIGNED
}

model Evaluation {
  id                Int        @id @default(autoincrement())
  templateId        Int
  evaluatorId       Int
  subjectId         Int
  status            EvalStatus @default(DRAFT)
  shiftDate         DateTime?  @db.Date
  notes             String?
  /// The evaluator's overall verdict, and whether they would promote.
  outcome           EvalOutcome?
  readyForPromotion Boolean?
  signedByEvaluator DateTime?
  signedBySubject   DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  template  EvalFormTemplate @relation(fields: [templateId], references: [id])
  evaluator Member           @relation("Evaluator", fields: [evaluatorId], references: [id])
  subject   Member           @relation("EvalSubject", fields: [subjectId], references: [id])
  scores    EvalScore[]

  @@index([subjectId])
  @@index([evaluatorId])
}

model EvalScore {
  evaluationId Int
  itemId       Int
  scaleValue   Int?
  passed       Boolean?
  textValue    String?
  /// For OPTIONS: the chosen option's value.
  optionValue  String?
  /// For MULTI_SELECT: every chosen value, in the item's offer order.
  optionValues String[]
  /// For NUMBER.
  numberValue  Float?

  evaluation Evaluation   @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  item       EvalFormItem @relation(fields: [itemId], references: [id])

  @@id([evaluationId, itemId])
}

// ---------------------------------------------------------------------------
// Promotions: TC unanimous vote (no abstentions, proxies for conflicts) + captain approval
// ---------------------------------------------------------------------------

enum PromoStatus {
  PENDING
  IN_VOTE
  TC_APPROVED // unanimous TC yes, awaiting captain
  APPROVED
  DENIED
  WITHDRAWN
}

// Per-member tweaks to a credential's requirement checklist: waive a base
// requirement, or add extra ones (structured, or free-text checked off
// manually). Applied wherever the checklist is computed.
enum AdjustmentKind {
  WAIVER
  ADDITIONAL
}

model PromotionRequirementAdjustment {
  id                  Int             @id @default(autoincrement())
  memberId            Int
  credentialTypeId    Int
  kind                AdjustmentKind
  requirementId       Int? // WAIVER: the base requirement being waived
  reqKind             RequirementKind? // ADDITIONAL structured requirement
  certificationTypeId Int?
  evalTemplateId      Int?
  count               Int?
  classId             Int?
  note                String? // waiver reason, or the free-text requirement itself
  satisfiedAt         DateTime? // manual completion for free-text ADDITIONAL items
  createdById         Int
  createdAt           DateTime        @default(now())

  member            Member                 @relation("AdjustmentSubject", fields: [memberId], references: [id], onDelete: Cascade)
  credentialType    CredentialType         @relation(fields: [credentialTypeId], references: [id], onDelete: Cascade)
  requirement       CredentialRequirement? @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  certificationType CertificationType?     @relation(fields: [certificationTypeId], references: [id])
  evalTemplate      EvalFormTemplate?      @relation(fields: [evalTemplateId], references: [id])
  class             TrainingClass?         @relation(fields: [classId], references: [id])
  createdBy         Member                 @relation("AdjustmentCreator", fields: [createdById], references: [id])

  @@index([memberId, credentialTypeId])
}

model PromotionRequest {
  id               Int         @id @default(autoincrement())
  memberId         Int
  credentialTypeId Int
  status           PromoStatus @default(PENDING)
  createdAt        DateTime    @default(now())
  resolvedAt       DateTime?

  member             Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  credentialType     CredentialType     @relation(fields: [credentialTypeId], references: [id])
  votes              PromotionVote[]
  proxies            PromotionProxy[]
  captainApproval    PromotionApproval?
  grantedCredentials MemberCredential[]

  @@index([memberId])
  @@index([status])
}

enum VoteChoice {
  APPROVE
  DENY
}

model PromotionVote {
  id         Int        @id @default(autoincrement())
  requestId  Int
  voterId    Int // the member who cast the vote
  proxyForId Int? // TC member of record when voterId is their appointed proxy
  vote       VoteChoice
  notes      String?
  castAt     DateTime   @default(now())

  request  PromotionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  voter    Member           @relation("Voter", fields: [voterId], references: [id])
  proxyFor Member?          @relation("ProxyFor", fields: [proxyForId], references: [id])

  @@unique([requestId, voterId, proxyForId])
}

model PromotionProxy {
  requestId   Int
  principalId Int // the TC member of record with the conflict of interest
  proxyId     Int // the member appointed to vote in their place

  request   PromotionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  principal Member           @relation("ProxyPrincipal", fields: [principalId], references: [id])
  proxy     Member           @relation("ProxyAgent", fields: [proxyId], references: [id])

  @@id([requestId, principalId])
}

model PromotionApproval {
  requestId  Int      @id
  approvedById Int
  approved   Boolean
  notes      String?
  decidedAt  DateTime @default(now())

  request PromotionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Scheduling: night crews
// ---------------------------------------------------------------------------

enum CrewPosition {
  CC
  DRIVER
  ATTENDANT
  OBSERVER
  DUTY_SUP
}

model Crew {
  id    Int      @id @default(autoincrement())
  date  DateTime @unique @db.Date
  slots CrewSlot[]
}

model CrewSlot {
  id          Int          @id @default(autoincrement())
  crewId      Int
  position    CrewPosition
  memberId    Int?
  placeholder String? // e.g. "CLOSED" (replaces the old negative pseudo-member ids)

  crew   Crew    @relation(fields: [crewId], references: [id], onDelete: Cascade)
  member Member? @relation(fields: [memberId], references: [id])

  @@unique([crewId, position])
  @@index([memberId])
}

model DefaultCrewTemplate {
  id          Int          @id @default(autoincrement())
  weekday     Int // 0 = Sunday ... 6 = Saturday
  position    CrewPosition
  memberId    Int?
  placeholder String?

  @@unique([weekday, position])
}

// Declared unavailability for a specific future date. Within the public
// window it clears an existing slot (drop deadline enforced); beyond it,
// weekly generation skips placing the member from the default template.
model CrewAbsence {
  id        Int      @id @default(autoincrement())
  memberId  Int
  date      DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, date])
  @@index([date])
}

// ---- weekly availability polls (input to the default schedule) ----

enum PollStatus {
  OPEN
  CLOSED
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  IF_NEEDED
}

model AvailabilityPoll {
  id          Int        @id @default(autoincrement())
  name        String // e.g. "Fall 2026"
  status      PollStatus @default(OPEN)
  createdById Int
  createdAt   DateTime   @default(now())
  closedAt    DateTime?

  createdBy Member                   @relation(fields: [createdById], references: [id])
  invites   AvailabilityPollInvite[]
  responses AvailabilityResponse[]
}

model AvailabilityPollInvite {
  pollId   Int
  memberId Int

  poll   AvailabilityPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  member Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([pollId, memberId])
}

model AvailabilityResponse {
  pollId   Int
  memberId Int
  weekday  Int // 0 = Sunday
  status   AvailabilityStatus

  poll   AvailabilityPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  member Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([pollId, memberId, weekday])
}

/// Operational configuration an administrator edits in the console, rather
/// than an environment variable only a deployer can reach. Values are JSON so
/// a setting can grow fields without a migration.
/// A message in a member's inbox. Every notification lands here — email and
/// Slack are extra delivery on top — so nothing is lost to a channel being
/// off or misconfigured.
model InboxMessage {
  id       Int    @id @default(autoincrement())
  memberId Int
  /// Message type key, e.g. "promotion.decided". Drives delivery settings.
  type     String
  subject  String
  body     String

  /// A task is something to be done, not merely read.
  isTask      Boolean   @default(false)
  actionLabel String?
  actionUrl   String?
  completedAt DateTime?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, readAt])
  @@index([memberId, isTask, completedAt])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// What the boot-time seeder has already provisioned.
///
/// A row here means "never create this again", which is what makes deleting
/// reference data in the console stick: without it every seeder is
/// create-if-missing, so a deployment quietly restores anything an
/// administrator removed.
model SeededReference {
  kind     String
  key      String
  seededAt DateTime @default(now())

  @@id([kind, key])
}

model SchedulingSetting {
  key   String @id // minAgeYears, riderSignupOpen, rotationWeeks, dayOfUnlockTime, probationaryRequiresTrainer, dropDeadline, ...
  value Json
}

// ---------------------------------------------------------------------------
// Unified events (absorbs the old games + events)
// ---------------------------------------------------------------------------

model EventKind {
  id       Int     @id @default(autoincrement())
  name     String  @unique // Game, Detail, Meeting, Social, ...
  defaults Json? // default position set etc.
  active   Boolean @default(true)
  events   Event[]
}

model EventTier {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  defaults    Json? // e.g. default crew requirements for the tier
  active      Boolean @default(true)
  events      Event[]
}

// Coverage-event workflow (spec: request -> details -> availability ->
// approval -> requester notified). Ordinary internal events stay APPROVED.
enum EventWorkflowStatus {
  DRAFT
  AVAILABILITY_REQUESTED
  PENDING_APPROVAL
  APPROVED
  DENIED
  CANCELLED
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime
  kindId      Int
  locked      Boolean  @default(false)
  attendeeCap Int? // cap for the non-positional pool; null = unlimited
  hidden      Boolean  @default(false)
  gcalEventId String?
  legacyKey   String?  @unique // "game-<id>" / "event-<id>" from the old MySQL portal
  workflowStatus EventWorkflowStatus @default(APPROVED)
  tierId      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  kind      EventKind       @relation(fields: [kindId], references: [id])
  tier      EventTier?      @relation(fields: [tierId], references: [id])
  positions EventPosition[]
  signups   EventSignup[]
  availabilityResponses EventAvailability[]
  coverageRequest        CoverageRequest?

  @@index([startsAt])
}

model EventPosition {
  id                    Int    @id @default(autoincrement())
  eventId               Int
  position              String // cc, driver, attendant, observer, ees, ...
  /// How many are wanted. Null means no limit — take everyone who signs up.
  count                 Int?
  requiredCredentialKey String? // CredentialType.key gate; null = open

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, position])
}

model EventSignup {
  id       Int     @id @default(autoincrement())
  eventId  Int
  memberId Int
  position String? // null = plain attendee (counted against attendeeCap)
  createdAt DateTime @default(now())

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
}

/** "I can work this" responses gathered during AVAILABILITY_REQUESTED. */
model EventAvailability {
  eventId   Int
  memberId  Int
  positions String[] // positions the member offers to fill
  note      String?
  createdAt DateTime @default(now())

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([eventId, memberId])
}

// Public coverage intake: outside requesters get a tokenized status link.
model CoverageRequest {
  id             Int       @id @default(autoincrement())
  token          String    @unique
  requesterName  String
  requesterOrg   String?
  requesterEmail String
  requesterPhone String?
  description    String
  requestedDate  DateTime? @db.Date
  location       String?
  createdAt      DateTime  @default(now())
  /// Set when a request is turned down before any event exists for it.
  declinedAt     DateTime?
  declineReason  String?
  eventId        Int?      @unique

  event    Event?            @relation(fields: [eventId], references: [id])
  messages CoverageMessage[]
}

enum MessageDirection {
  FROM_REQUESTER
  TO_REQUESTER
}

model CoverageMessage {
  id        Int              @id @default(autoincrement())
  requestId Int
  direction MessageDirection
  body      String
  authorId  Int? // staff member for TO_REQUESTER
  createdAt DateTime         @default(now())

  request CoverageRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  Member?         @relation(fields: [authorId], references: [id])
}

// ---------------------------------------------------------------------------
// Annual trainings & classes
// ---------------------------------------------------------------------------

model AnnualTrainingRequirement {
  id               Int     @id @default(autoincrement())
  name             String
  year             Int
  alertOnLapse     Boolean @default(true) // per-training toggle: alert officers when a member lapses
  blocksScheduling Boolean @default(false) // outstanding completion blocks night-crew signup
  active           Boolean @default(true)

  completions MemberAnnualTraining[]

  @@unique([name, year])
}

model MemberAnnualTraining {
  requirementId Int
  memberId      Int
  completedAt   DateTime?

  requirement AnnualTrainingRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  member      Member                    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([requirementId, memberId])
}

model TrainingClass {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  sessionAt   DateTime?
  location    String?

  attendance             ClassAttendance[]
  credentialRequirements CredentialRequirement[]
  requirementAdjustments PromotionRequirementAdjustment[]
}

enum AttendanceStatus {
  REGISTERED
  ATTENDED
  COMPLETED
  NO_SHOW
}

model ClassAttendance {
  classId  Int
  memberId Int
  status   AttendanceStatus @default(REGISTERED)

  class  TrainingClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  member Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([classId, memberId])
}

// ---------------------------------------------------------------------------
// Ops logs
// ---------------------------------------------------------------------------

model Vehicle {
  id     Int     @id @default(autoincrement())
  name   String  @unique // e.g. "A-1", "Fly Car"
  make   String?
  model  String?
  year   Int?
  plate  String?
  vin    String?
  notes  String?
  active Boolean @default(true)

  fuelEntries FuelLogEntry[]
}

model FuelLogEntry {
  id        Int      @id @default(autoincrement())
  loggedAt  DateTime
  memberId  Int
  vehicle   String // display label (kept for legacy-migrated rows)
  vehicleId Int?
  amount    Decimal  @db.Decimal(6, 2)
  mileage   Int

  member     Member   @relation(fields: [memberId], references: [id])
  vehicleRef Vehicle? @relation(fields: [vehicleId], references: [id])
}

model Radio {
  id          Int     @id @default(autoincrement())
  number      String  @unique
  model       String?
  serial      String?
  accessories Json? // charger, tac mic, extra battery, ...
  retired     Boolean @default(false)

  assignments RadioAssignment[]
}

model RadioAssignment {
  id         Int       @id @default(autoincrement())
  radioId    Int
  memberId   Int
  issuedAt   DateTime  @default(now())
  returnedAt DateTime?

  radio  Radio  @relation(fields: [radioId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id])

  @@index([radioId])
  @@index([memberId])
}

// Parsed text-message dispatches ingested from Herald (techinems/herald).
model Dispatch {
  id             Int      @id @default(autoincrement())
  receivedAt     DateTime @default(now())
  determinant    String? // Alpha/Bravo/Charlie/Delta/Echo/Unknown
  complaint      String?
  location       String?
  business       String?
  additionalInfo String?
  crossStreets   String?
  units          String? // e.g. "E59"
  responseAreas  String?
  latitude       Float?
  longitude      Float?
  geocodedPlace  String?
  raw            Json // the full payload as received, for reprocessing

  @@index([receivedAt])
}

// ---------------------------------------------------------------------------
// Tokens & audit
// ---------------------------------------------------------------------------

enum IcsScope {
  MY_SCHEDULE
  MY_SCHEDULE_AND_ALL_EVENTS
}

model IcsToken {
  id        Int      @id @default(autoincrement())
  memberId  Int
  token     String   @unique
  scope     IcsScope
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model ApiToken {
  id          Int       @id @default(autoincrement())
  name        String
  tokenHash   String    @unique // sha256 of the secret (prefix rpa_); plaintext shown once
  ownerId     Int
  permissions String[] // explicit subset of the permission catalog
  expiresAt   DateTime?
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  owner Member @relation(fields: [ownerId], references: [id])
}

enum ActorType {
  MEMBER
  API_TOKEN
  SYSTEM
}

model AuditLog {
  id        BigInt    @id @default(autoincrement())
  actorType ActorType
  actorId   Int?
  action    String // e.g. credential.appoint, schedule.crews.assign
  entity    String
  entityId  String?
  diff      Json?
  /// Where the request came from, as reported by the proxy in front of the
  /// API. Null for anything not raised by an HTTP request — scheduled jobs,
  /// boot-time work.
  ip        String?
  userAgent String?
  at        DateTime  @default(now())

  @@index([entity, entityId])
  @@index([at])
}

/// Every request the API served, and every page the portals rendered.
///
/// Separate from AuditLog on purpose: that one records decisions somebody
/// made and is meant to be read, while this one records traffic and grows by
/// a row per request. Keeping them apart means a retention sweep here never
/// touches the record of who changed what.
model AccessLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  /// 'API' for a request this service served, 'PAGE' for one of the portals
  /// reporting a page it rendered.
  kind       String   @default("API")
  memberId   Int?
  apiTokenId Int?
  method     String
  path       String
  status     Int?
  durationMs Int?
  ip         String?
  userAgent  String?

  @@index([at])
  @@index([memberId, at])
  @@index([path])
}
