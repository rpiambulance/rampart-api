// Rampart API — Prisma schema
// Spec: rpiambulance/website docs/modernization-spec.md

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Members
// ---------------------------------------------------------------------------

model Member {
  id              Int       @id @default(autoincrement())
  legacyId        Int?      @unique // members.id from the old MySQL portal
  keycloakSubject String?   @unique
  /// The legal first name: what is on the licence and the certification
  /// card, and what the agency is obliged to record. Only an officer changes
  /// it, because it is identity.
  firstName       String
  /// What they would rather be called. Theirs to set, and what the portal
  /// shows wherever a name is shown to people rather than to a registry.
  preferredFirstName String?
  lastName        String
  dob             DateTime? @db.Date
  email           String    @unique
  personalEmail   String?
  cellPhone       String?
  homePhone       String?
  localAddress    String?
  homeAddress     String?
  rcsId           String?
  /// RPI 900 number. Kept for credentialed members and officers by
  /// convention, not by rule — nothing here requires or checks it.
  nineHundredNumber String? @map("900number")
  rin             String?
  facilityId      String?
  cardId          String?
  slackId         String?   @unique
  active          Boolean   @default(true)
  navLayout       String    @default("sidebar") // UI preference: sidebar | topnav
  eventView       String    @default("list") // UI preference: list | day | week | month
  timeFormat      String    @default("24h") // UI preference: 24h | 12h
  /// UI preference: how the inbox is ordered. See INBOX_SORTS.
  inboxSort       String    @default("unreadFirst")

  /// The last time this member said their own details are right, and the
  /// last time somebody asked them to. A request outstanding is simply a
  /// request newer than the confirmation — no third state to keep in step,
  /// and asking twice cannot lose an answer given in between.
  profileConfirmedAt        DateTime?
  profileReviewRequestedAt  DateTime?
  profileReviewRequestedById Int?
  profileReviewNote          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  roles              MemberRole[]
  credentials        MemberCredential[]
  certifications     MemberCertification[]
  verifiedCerts      MemberCertification[] @relation("CertVerifier")
  evaluationsWritten Evaluation[]          @relation("Evaluator")
  evaluationsAbout   Evaluation[]          @relation("EvalSubject")
  evaluationsAsked   Evaluation[]          @relation("EvalRequester")
  checklistSignoffs  ChecklistSignoff[]    @relation("ChecklistSubject")
  checklistsStarted  ChecklistEnrollment[] @relation("ChecklistEnrolled")
  checklistsBegunFor ChecklistEnrollment[] @relation("ChecklistStarter")
  crewsTakenOutOfService Crew[]            @relation("CrewOutOfServiceBy")
  inboxTasksCompleted    InboxMessage[]    @relation("InboxCompletedBy")
  evalAttachments        EvalAttachment[]  @relation("EvalAttachmentUploader")
  unlinkedLoginsResolved UnlinkedLogin[]   @relation("UnlinkedLoginResolver")
  profileChangesAsked    ProfileChangeRequest[] @relation("ProfileChangeSubject")
  profileChangesDecided  ProfileChangeRequest[] @relation("ProfileChangeDecider")
  inviteCodesCreated     InviteCode[]     @relation("InviteCodeCreator")
  inviteCodesClosed      InviteCode[]     @relation("InviteCodeCloser")
  accountRequestsDecided AccountRequest[] @relation("AccountRequestDecider")
  accountRequestMember   AccountRequest[] @relation("AccountRequestMember")
  profileReviewsRequested Member[]         @relation("ProfileReviewRequestedBy")
  profileReviewRequestedBy Member?         @relation("ProfileReviewRequestedBy", fields: [profileReviewRequestedById], references: [id])
  resourcesCreated       Resource[]        @relation("ResourceCreator")
  checksheetRuns         ChecksheetRun[]        @relation("ChecksheetCompletedBy")
  deficienciesResolved   ChecksheetDeficiency[] @relation("DeficiencyResolvedBy")
  webhooksCreated    Webhook[]             @relation("WebhookCreator")
  choresAssigned     Chore[]               @relation("ChoreAssignee")
  choresCompleted    ChoreOccurrence[]     @relation("ChoreCompleter")
  choreNightsAssigned ChoreOccurrence[]    @relation("ChoreOccurrenceAssignee")
  runNumbersIssued   RunNumber[]           @relation("RunNumberIssuer")
  certTypesProposed  CertificationType[]   @relation("CertTypeProposer")
  checklistSigned    ChecklistSignoff[]    @relation("ChecklistSigner")
  checklistRevoked   ChecklistSignoff[]    @relation("ChecklistRevoker")
  promotionRequests  PromotionRequest[]
  promotionVotes     PromotionVote[]       @relation("Voter")
  proxiedVotes       PromotionVote[]       @relation("ProxyFor")
  proxyPrincipalOf   PromotionProxy[]      @relation("ProxyPrincipal")
  proxyAgentOf       PromotionProxy[]      @relation("ProxyAgent")
  requirementAdjustments PromotionRequirementAdjustment[] @relation("AdjustmentSubject")
  adjustmentsCreated     PromotionRequirementAdjustment[] @relation("AdjustmentCreator")
  crewSlots          CrewSlot[]
  eventSignups       EventSignup[]
  fuelLogEntries     FuelLogEntry[]
  radioAssignments   RadioAssignment[]
  icsTokens          IcsToken[]
  apiTokens          ApiToken[]
  annualTrainings    MemberAnnualTraining[]
  classAttendance    ClassAttendance[]
  crewAbsences       CrewAbsence[]
  pollInvites        AvailabilityPollInvite[]
  availability       AvailabilityResponse[]
  inbox              InboxMessage[]
  pollsCreated       AvailabilityPoll[]
  eventAvailability  EventAvailability[]
  coverageMessages   CoverageMessage[]
}

// ---------------------------------------------------------------------------
// RBAC: permissions catalog (string keys defined in code) -> roles -> members
// ---------------------------------------------------------------------------

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  isOfficer   Boolean          @default(false)
  permissions RolePermission[]
  members     MemberRole[]
  credentialLinks CredentialTypeRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  checksheetTemplates ChecksheetTemplate[] @relation("ChecksheetNotifyRoles")
}

model RolePermission {
  roleId     Int
  permission String // key from the permission catalog (src/permissions/catalog.ts)
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
}

model MemberRole {
  id        Int       @id @default(autoincrement())
  memberId  Int
  roleId    Int
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date // null = appointed / open-ended
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([roleId])
}

// ---------------------------------------------------------------------------
// Certifications (external, expiring documents)
// ---------------------------------------------------------------------------

model CertificationType {
  id                    Int     @id @default(autoincrement())
  name                  String  @unique
  abbreviation          String
  issuingOrg            String?
  defaultValidityMonths Int? // null = non-expiring
  /// What this type asks of whoever submits it. A driver's licence needs its
  /// number and its expiry; a one-off class needs neither, and asking anyway
  /// trains people to leave fields blank. Everything defaults to OPTIONAL,
  /// which is how every type behaved before this existed.
  identifierField       FieldRequirement @default(OPTIONAL)
  issuedAtField         FieldRequirement @default(OPTIONAL)
  expiresAtField        FieldRequirement @default(OPTIONAL)
  documentField         FieldRequirement @default(OPTIONAL)
  active                Boolean @default(true)
  /// Suggested by a member submitting a certification the list did not have.
  /// It works like any other type, but is marked until somebody with settings
  /// permission has looked at how it is configured — an abbreviation and a
  /// validity period guessed by whoever happened to submit first should not
  /// silently become the agency's.
  proposed              Boolean @default(false)
  proposedById          Int?
  proposedAt            DateTime?

  proposedBy Member? @relation("CertTypeProposer", fields: [proposedById], references: [id])

  memberCertifications  MemberCertification[]
  credentialRequirements CredentialRequirement[]
  requirementAdjustments PromotionRequirementAdjustment[]
  /// Certifications this one outranks, and the ones that outrank it.
  supersedes             CertificationSupersession[] @relation("Supersedes")
  supersededBy           CertificationSupersession[] @relation("SupersededBy")
}

/// Certification ranking: holding the higher one satisfies a requirement for
/// the lower. A Paramedic answers a requirement for EMT.
model CertificationSupersession {
  higherTypeId Int
  lowerTypeId  Int

  higher CertificationType @relation("Supersedes", fields: [higherTypeId], references: [id], onDelete: Cascade)
  lower  CertificationType @relation("SupersededBy", fields: [lowerTypeId], references: [id], onDelete: Cascade)

  @@id([higherTypeId, lowerTypeId])
  @@index([lowerTypeId])
}


/// Whether a field is asked for, and whether it may be left blank.
enum FieldRequirement {
  HIDDEN
  OPTIONAL
  REQUIRED
}

enum CertStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

model MemberCertification {
  id              Int        @id @default(autoincrement())
  memberId        Int
  typeId          Int
  identifier      String? // cert / license number
  issuedAt        DateTime?  @db.Date
  expiresAt       DateTime?  @db.Date
  status          CertStatus @default(PENDING_VERIFICATION)
  verifiedById    Int?
  verifiedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  member     Member                  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type       CertificationType       @relation(fields: [typeId], references: [id])
  verifiedBy Member?                 @relation("CertVerifier", fields: [verifiedById], references: [id])
  documents  CertificationDocument[]

  @@index([memberId])
  @@index([expiresAt])
}

/// Uploaded proof of a certification — licence cards, course certificates.
///
/// The id is a random UUID rather than a sequence: it addresses a file of
/// somebody's personal paperwork, and a sequential one lets anyone who can
/// open a single document walk the whole archive by counting, and read off
/// how many exist. Nothing points at these rows, so the opaque id costs
/// nothing elsewhere.
model CertificationDocument {
  id              String   @id @default(uuid(4))
  certificationId Int
  storageKey      String // key in the object store (local driver or S3)
  fileName        String
  contentType     String
  sizeBytes       Int
  uploadedAt      DateTime @default(now())

  certification MemberCertification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Credentials — progression tree (O -> A -> {A-D -> P-D -> D -> D-T | A-CC -> P-CC -> CC -> CC-T})
// CC add-ons: FR-CC, EES. DS is a captain appointment (SDS = DS with a different title).
// ---------------------------------------------------------------------------

enum GrantMethod {
  PROMOTION // TC unanimous vote + captain approval
  APPOINTMENT // captain only (DS)
}

model CredentialType {
  id          Int         @id @default(autoincrement())
  key         String      @unique // O, A, A_D, P_D, D, D_T, A_CC, P_CC, CC, CC_T, FR_CC, EES, DS
  name        String
  grantMethod GrantMethod @default(PROMOTION)
  isAddOn     Boolean     @default(false) // FR-CC, EES
  /// Satisfies every credential requirement regardless of the prerequisite
  /// graph. A Duty Supervisor outranks the whole ladder, including add-ons
  /// (FR-CC) that are not in its own prerequisite chain.
  outranksAll Boolean     @default(false)
  active      Boolean     @default(true)

  linkedRoles     CredentialTypeRole[] // roles conferred automatically while ACTIVE
  prerequisites   CredentialPrerequisite[] @relation("Prerequisites")
  prerequisiteOf  CredentialPrerequisite[] @relation("PrerequisiteOf")
  requirements    CredentialRequirement[]
  memberCredentials MemberCredential[]
  promotionRequests PromotionRequest[]
  requirementAdjustments PromotionRequirementAdjustment[]
  checklistSignoffLevel  EvalFormTemplate[] @relation("ChecklistSignoffLevel")
  checklistItemLevel     EvalFormItem[]     @relation("ChecklistItemSignoffLevel")
}

// Holding this credential ACTIVE confers the linked role's permissions
// (additive with explicitly assigned roles; suspension removes them).
model CredentialTypeRole {
  credentialTypeId Int
  roleId           Int

  credentialType CredentialType @relation(fields: [credentialTypeId], references: [id], onDelete: Cascade)
  role           Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([credentialTypeId, roleId])
}

model CredentialPrerequisite {
  credentialTypeId Int
  requiresTypeId   Int
  credentialType   CredentialType @relation("Prerequisites", fields: [credentialTypeId], references: [id], onDelete: Cascade)
  requiresType     CredentialType @relation("PrerequisiteOf", fields: [requiresTypeId], references: [id], onDelete: Cascade)

  @@id([credentialTypeId, requiresTypeId])
}

/// When a requirement is checked, which decides what failing it costs.
enum RequirementScope {
  /// Met before the credential is granted, then never revisited. Adding one
  /// cannot affect anybody who already holds the credential.
  PROMOTION
  /// Held continuously. Losing it suspends the credential, so adding one is a
  /// decision about everybody who holds it, not only about future holders.
  ONGOING
  /// Needed to earn it and to keep it.
  BOTH
}

enum RequirementKind {
  CERTIFICATION // a verified, unexpired cert of certificationTypeId
  EVALUATION_COUNT // `count` signed evals on evalTemplateId
  CLASS // completion of classId
  CHECKLIST // every line of the checklist at evalTemplateId signed off
}

model CredentialRequirement {
  id                  Int             @id @default(autoincrement())
  credentialTypeId    Int
  kind                RequirementKind
  certificationTypeId Int?
  evalTemplateId      Int?
  count               Int?
  classId             Int?
  /// Requirements sharing a group are alternatives: satisfying any one of
  /// them satisfies the group. Null means the requirement stands alone and
  /// must be met. A label rather than a number so the checklist can say
  /// "Driving qualification: any of…" instead of "group 2".
  alternativeGroup    String?
  /// Whether this is checked at promotion, continuously, or both. Defaults to
  /// promotion: a requirement added today should not suspend somebody who
  /// earned the credential years ago without being asked to.
  scope               RequirementScope @default(PROMOTION)
  /// An ongoing requirement does not bite until this date, so people can be
  /// told and given time. Null means immediately.
  effectiveFrom       DateTime?        @db.Date

  credentialType    CredentialType     @relation(fields: [credentialTypeId], references: [id], onDelete: Cascade)
  certificationType CertificationType? @relation(fields: [certificationTypeId], references: [id])
  evalTemplate      EvalFormTemplate?  @relation(fields: [evalTemplateId], references: [id])
  class             TrainingClass?     @relation(fields: [classId], references: [id])
  adjustments       PromotionRequirementAdjustment[]
}

enum CredentialStatus {
  ACTIVE
  SUSPENDED // automatic: a required cert lapsed
  REVOKED
}

model MemberCredential {
  id           Int              @id @default(autoincrement())
  memberId     Int
  typeId       Int
  status       CredentialStatus @default(ACTIVE)
  title        String? // display-title override, e.g. "Senior Duty Supervisor" on a DS credential
  grantedAt    DateTime         @default(now()) // when this row was created here
  /// When the member actually earned it. Null while unknown — a backfilled
  /// credential can be recorded now and dated later. Prefer this over
  /// grantedAt for display.
  effectiveAt  DateTime?        @db.Date
  grantedViaId Int? // PromotionRequest id; null for appointments/corrections
  revokedAt    DateTime?

  member     Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type       CredentialType    @relation(fields: [typeId], references: [id])
  grantedVia PromotionRequest? @relation(fields: [grantedViaId], references: [id])

  @@unique([memberId, typeId])
  @@index([typeId])
}

// ---------------------------------------------------------------------------
// Training: eval form templates + evaluations
// ---------------------------------------------------------------------------

enum ScoreType {
  SCALE_1_5
  PASS_FAIL
  /// Free text, several lines.
  TEXT
  /// Free text, one line.
  SHORT_TEXT
  /// A number, with optional bounds on the item.
  NUMBER
  /// A list of choices, defined on the item. Pick one.
  OPTIONS
  /// The same list, but any number of them may be picked.
  MULTI_SELECT
  /// Not a question: a heading or instruction shown on the form.
  HEADING
  /// A line on a checklist: signed off rather than answered.
  SIGNOFF
}

/// Evaluations are filled in once; checklists are signed off item by item,
/// over time, by whoever is qualified to sign each line.
/// Whether a form takes attachments, and whether it requires them.
enum AttachmentRequirement {
  NONE
  OPTIONAL
  REQUIRED
}

enum TemplateKind {
  EVALUATION
  CHECKLIST
}

/// The evaluator's overall verdict on an evaluation.
/// Whether the person being evaluated fills an item in themselves.
enum TraineeInput {
  /// The evaluator's to answer; the trainee never sees a field for it.
  NONE
  /// The trainee may answer it when asking for the evaluation.
  OPTIONAL
  /// The trainee must answer it before the request can be sent.
  REQUIRED
}

enum EvalOutcome {
  NEEDS_IMPROVEMENT
  PASSED
}

model EvalFormTemplate {
  id        Int          @id @default(autoincrement())
  name      String
  kind      TemplateKind @default(EVALUATION)
  version   Int          @default(1)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())

  /// Whether this form takes files at all, and whether it insists — a run
  /// report wants the patient care documentation attached; a shift
  /// evaluation wants nothing.
  attachments AttachmentRequirement @default(NONE)
  /// Shows a warning before the file picker that what is uploaded must carry
  /// no protected health information. Off by default: a warning on every
  /// form is a warning nobody reads by the time it matters.
  phiWarning  Boolean               @default(false)

  /// Checklists only: the credentials that let someone sign. Holding any one
  /// of them — or anything above it on the ladder — is enough. An item may
  /// name its own set instead.
  signoffCredentialTypes CredentialType[] @relation("ChecklistSignoffLevel")

  enrollments            ChecklistEnrollment[]
  groups                 EvalFormGroup[]
  items                  EvalFormItem[]
  evaluations            Evaluation[]
  credentialRequirements CredentialRequirement[]
  requirementAdjustments PromotionRequirementAdjustment[]

  @@unique([name, version])
}

/// A titled run of items. Groups and loose items share one ordering space at
/// the top of a form, so a group moves exactly like a single item does.
model EvalFormGroup {
  id         Int    @id @default(autoincrement())
  templateId Int
  order      Int
  heading    String
  /// Shown under the heading, before the first item.
  description String?

  template EvalFormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    EvalFormItem[]

  @@index([templateId])
}

model EvalFormItem {
  id         Int       @id @default(autoincrement())
  templateId Int
  /// Null = loose at the top level; otherwise the group it sits in. `order`
  /// is read within whichever of the two contains it.
  groupId    Int?
  order      Int
  prompt     String
  scoreType  ScoreType
  /// For OPTIONS and MULTI_SELECT: [{ value, label }], in offer order.
  options    Json?
  /// NUMBER only: bounds and unit, all optional.
  minValue   Float?
  maxValue   Float?
  unit       String?
  /// Whether the trainee fills this in when requesting the evaluation.
  traineeInput TraineeInput @default(NONE)

  template              EvalFormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  group                 EvalFormGroup?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Checklists only: who may sign this line, instead of the checklist's own
  /// set. Empty means the checklist's set applies.
  signoffCredentialTypes CredentialType[] @relation("ChecklistItemSignoffLevel")
  scores                EvalScore[]
  signoffs              ChecklistSignoff[]

  @@index([templateId])
  @@index([groupId])
}

/// Somebody working through a checklist.
///
/// Checklists used to apply to everyone pursuing the credential they lead to,
/// which meant a member's list filled with things nobody had asked them to
/// start. Working through one is now a decision — the member's own, or a
/// trainer's on their behalf — and this records it.
model ChecklistEnrollment {
  id          Int      @id @default(autoincrement())
  templateId  Int
  memberId    Int
  /// Who started it: the member themselves, or the trainer who did.
  startedById Int?
  startedAt   DateTime @default(now())

  template  EvalFormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  member    Member           @relation("ChecklistEnrolled", fields: [memberId], references: [id], onDelete: Cascade)
  startedBy Member?          @relation("ChecklistStarter", fields: [startedById], references: [id])

  @@unique([templateId, memberId])
  @@index([memberId])
}

/// One trainer putting their name to one checklist line for one trainee.
///
/// Rows are kept after revocation rather than deleted, so a checklist can
/// answer "who signed this, and did anyone take it back" — which is the whole
/// point of signing it. The live sign-off is the newest un-revoked row.
model ChecklistSignoff {
  id           Int       @id @default(autoincrement())
  memberId     Int
  itemId       Int
  signedById   Int
  signedAt     DateTime  @default(now())
  note         String?
  revokedAt    DateTime?
  revokedById  Int?
  revokeReason String?

  member    Member       @relation("ChecklistSubject", fields: [memberId], references: [id], onDelete: Cascade)
  item      EvalFormItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  signedBy  Member       @relation("ChecklistSigner", fields: [signedById], references: [id])
  revokedBy Member?      @relation("ChecklistRevoker", fields: [revokedById], references: [id])

  @@index([memberId, itemId])
  @@index([itemId])
}

enum EvalStatus {
  DRAFT
  SUBMITTED
  SIGNED
}

/// A file attached to a completed evaluation.
///
/// Opaque id for the same reason certification documents have one: the URL
/// is the only thing standing between a file and somebody guessing the next
/// number along.
model EvalAttachment {
  id           String   @id @default(uuid(4))
  evaluationId Int
  /// What this file is, in the evaluator's words: "PCR page 1", "12-lead".
  /// A list of filenames is not a record anybody can read later.
  title        String
  /// Ordering as entered, so the list reads the way it was built.
  position     Int      @default(0)
  storageKey   String
  fileName     String
  contentType  String
  sizeBytes    Int
  uploadedById Int?
  uploadedAt   DateTime @default(now())

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  uploadedBy Member?    @relation("EvalAttachmentUploader", fields: [uploadedById], references: [id])

  @@index([evaluationId])
}

model Evaluation {
  id                Int        @id @default(autoincrement())
  templateId        Int
  evaluatorId       Int
  subjectId         Int
  status            EvalStatus @default(DRAFT)
  /// The day being evaluated.
  evalDate          DateTime?  @db.Date
  /// Set when the trainee asked for this rather than the trainer starting it.
  requestedById     Int?
  requestedAt       DateTime?
  notes             String?
  /// The evaluator's overall verdict, and whether they would promote.
  outcome           EvalOutcome?
  readyForPromotion Boolean?
  signedByEvaluator DateTime?
  signedBySubject   DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  template  EvalFormTemplate @relation(fields: [templateId], references: [id])
  evaluator Member           @relation("Evaluator", fields: [evaluatorId], references: [id])
  requestedBy Member?        @relation("EvalRequester", fields: [requestedById], references: [id])
  subject   Member           @relation("EvalSubject", fields: [subjectId], references: [id])
  scores      EvalScore[]
  attachments EvalAttachment[]

  @@index([subjectId])
  @@index([evaluatorId])
}

model EvalScore {
  evaluationId Int
  itemId       Int
  scaleValue   Int?
  passed       Boolean?
  textValue    String?
  /// For OPTIONS: the chosen option's value.
  optionValue  String?
  /// For MULTI_SELECT: every chosen value, in the item's offer order.
  optionValues String[]
  /// For NUMBER.
  numberValue  Float?

  evaluation Evaluation   @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  item       EvalFormItem @relation(fields: [itemId], references: [id])

  @@id([evaluationId, itemId])
}

// ---------------------------------------------------------------------------
// Promotions: TC unanimous vote (no abstentions, proxies for conflicts) + captain approval
// ---------------------------------------------------------------------------

enum PromoStatus {
  PENDING
  IN_VOTE
  TC_APPROVED // unanimous TC yes, awaiting captain
  APPROVED
  DENIED
  WITHDRAWN
}

// Per-member tweaks to a credential's requirement checklist: waive a base
// requirement, or add extra ones (structured, or free-text checked off
// manually). Applied wherever the checklist is computed.
enum AdjustmentKind {
  WAIVER
  ADDITIONAL
}

model PromotionRequirementAdjustment {
  id                  Int             @id @default(autoincrement())
  memberId            Int
  credentialTypeId    Int
  kind                AdjustmentKind
  requirementId       Int? // WAIVER: the base requirement being waived
  reqKind             RequirementKind? // ADDITIONAL structured requirement
  certificationTypeId Int?
  evalTemplateId      Int?
  count               Int?
  classId             Int?
  note                String? // waiver reason, or the free-text requirement itself
  satisfiedAt         DateTime? // manual completion for free-text ADDITIONAL items
  createdById         Int
  createdAt           DateTime        @default(now())

  member            Member                 @relation("AdjustmentSubject", fields: [memberId], references: [id], onDelete: Cascade)
  credentialType    CredentialType         @relation(fields: [credentialTypeId], references: [id], onDelete: Cascade)
  requirement       CredentialRequirement? @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  certificationType CertificationType?     @relation(fields: [certificationTypeId], references: [id])
  evalTemplate      EvalFormTemplate?      @relation(fields: [evalTemplateId], references: [id])
  class             TrainingClass?         @relation(fields: [classId], references: [id])
  createdBy         Member                 @relation("AdjustmentCreator", fields: [createdById], references: [id])

  @@index([memberId, credentialTypeId])
}

model PromotionRequest {
  id               Int         @id @default(autoincrement())
  memberId         Int
  credentialTypeId Int
  status           PromoStatus @default(PENDING)
  createdAt        DateTime    @default(now())
  resolvedAt       DateTime?

  member             Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  credentialType     CredentialType     @relation(fields: [credentialTypeId], references: [id])
  votes              PromotionVote[]
  proxies            PromotionProxy[]
  captainApproval    PromotionApproval?
  grantedCredentials MemberCredential[]

  @@index([memberId])
  @@index([status])
}

enum VoteChoice {
  APPROVE
  DENY
}

model PromotionVote {
  id         Int        @id @default(autoincrement())
  requestId  Int
  voterId    Int // the member who cast the vote
  proxyForId Int? // TC member of record when voterId is their appointed proxy
  vote       VoteChoice
  notes      String?
  castAt     DateTime   @default(now())

  request  PromotionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  voter    Member           @relation("Voter", fields: [voterId], references: [id])
  proxyFor Member?          @relation("ProxyFor", fields: [proxyForId], references: [id])

  @@unique([requestId, voterId, proxyForId])
}

model PromotionProxy {
  requestId   Int
  principalId Int // the TC member of record with the conflict of interest
  proxyId     Int // the member appointed to vote in their place

  request   PromotionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  principal Member           @relation("ProxyPrincipal", fields: [principalId], references: [id])
  proxy     Member           @relation("ProxyAgent", fields: [proxyId], references: [id])

  @@id([requestId, principalId])
}

model PromotionApproval {
  requestId  Int      @id
  approvedById Int
  approved   Boolean
  notes      String?
  decidedAt  DateTime @default(now())

  request PromotionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Scheduling: night crews
// ---------------------------------------------------------------------------

enum CrewPosition {
  CC
  DRIVER
  ATTENDANT
  OBSERVER
  DUTY_SUP
}

model Crew {
  id    Int      @id @default(autoincrement())
  date  DateTime @unique @db.Date
  /// The agency is not running a crew that night. The duty supervisor seat
  /// is kept regardless — somebody still carries the phone — so this marks
  /// the night rather than emptying it.
  outOfService       Boolean   @default(false)
  outOfServiceReason String?
  outOfServiceAt     DateTime?
  outOfServiceById   Int?

  outOfServiceBy Member?    @relation("CrewOutOfServiceBy", fields: [outOfServiceById], references: [id])
  slots          CrewSlot[]
}

model CrewSlot {
  id          Int          @id @default(autoincrement())
  crewId      Int
  position    CrewPosition
  memberId    Int?
  placeholder String? // e.g. "CLOSED" (replaces the old negative pseudo-member ids)

  crew   Crew    @relation(fields: [crewId], references: [id], onDelete: Cascade)
  member Member? @relation(fields: [memberId], references: [id])

  @@unique([crewId, position])
  @@index([memberId])
}

model DefaultCrewTemplate {
  id          Int          @id @default(autoincrement())
  weekday     Int // 0 = Sunday ... 6 = Saturday
  position    CrewPosition
  memberId    Int?
  placeholder String?

  @@unique([weekday, position])
}

// Declared unavailability for a specific future date. Within the public
// window it clears an existing slot (drop deadline enforced); beyond it,
// weekly generation skips placing the member from the default template.
model CrewAbsence {
  id        Int      @id @default(autoincrement())
  memberId  Int
  date      DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, date])
  @@index([date])
}

// ---- weekly availability polls (input to the default schedule) ----

enum PollStatus {
  OPEN
  CLOSED
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  IF_NEEDED
}

model AvailabilityPoll {
  id          Int        @id @default(autoincrement())
  name        String // e.g. "Fall 2026"
  status      PollStatus @default(OPEN)
  createdById Int
  createdAt   DateTime   @default(now())
  closedAt    DateTime?

  createdBy Member                   @relation(fields: [createdById], references: [id])
  invites   AvailabilityPollInvite[]
  responses AvailabilityResponse[]
}

model AvailabilityPollInvite {
  pollId   Int
  memberId Int

  poll   AvailabilityPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  member Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([pollId, memberId])
}

model AvailabilityResponse {
  pollId   Int
  memberId Int
  weekday  Int // 0 = Sunday
  status   AvailabilityStatus

  poll   AvailabilityPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  member Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([pollId, memberId, weekday])
}

/// Operational configuration an administrator edits in the console, rather
/// than an environment variable only a deployer can reach. Values are JSON so
/// a setting can grow fields without a migration.
/// A message in a member's inbox. Every notification lands here — email and
/// Slack are extra delivery on top — so nothing is lost to a channel being
/// off or misconfigured.
model InboxMessage {
  id       Int    @id @default(autoincrement())
  memberId Int
  /// Message type key, e.g. "promotion.decided". Drives delivery settings.
  type     String
  subject  String
  body     String

  /// A task is something to be done, not merely read.
  isTask      Boolean   @default(false)
  actionLabel String?
  actionUrl   String?
  completedAt DateTime?
  /// Who dealt with it. Usually the recipient, but a task sent to everyone
  /// who could do a thing is finished by whichever one of them does it, and
  /// the rest should be told by whom rather than finding it silently gone.
  completedById Int?

  /// What the task is about, when it is about a record — so that acting on
  /// that record can close every copy of the task at once. Deliberately a
  /// loose reference rather than a relation per kind: the inbox does not want
  /// a foreign key to every table in the schema.
  subjectType String?
  subjectId   Int?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  member      Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  completedBy Member? @relation("InboxCompletedBy", fields: [completedById], references: [id])

  @@index([memberId, readAt])
  @@index([memberId, isTask, completedAt])
  @@index([subjectType, subjectId])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// What the boot-time seeder has already provisioned.
///
/// A row here means "never create this again", which is what makes deleting
/// reference data in the console stick: without it every seeder is
/// create-if-missing, so a deployment quietly restores anything an
/// administrator removed.
model SeededReference {
  kind     String
  key      String
  seededAt DateTime @default(now())

  @@id([kind, key])
}

model SchedulingSetting {
  key   String @id // minAgeYears, riderSignupOpen, rotationWeeks, dayOfUnlockTime, probationaryRequiresTrainer, dropDeadline, ...
  value Json
}

// ---------------------------------------------------------------------------
// Unified events (absorbs the old games + events)
// ---------------------------------------------------------------------------

model EventKind {
  id       Int     @id @default(autoincrement())
  name     String  @unique // Game, Detail, Meeting, Social, ...
  defaults Json? // default position set etc.
  active   Boolean @default(true)
  events   Event[]
}

model EventTier {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  defaults    Json? // e.g. default crew requirements for the tier
  active      Boolean @default(true)
  events      Event[]
}

// Coverage-event workflow (spec: request -> details -> availability ->
// approval -> requester notified). Ordinary internal events stay APPROVED.
enum EventWorkflowStatus {
  DRAFT
  AVAILABILITY_REQUESTED
  PENDING_APPROVAL
  APPROVED
  DENIED
  CANCELLED
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime
  kindId      Int
  locked      Boolean  @default(false)
  attendeeCap Int? // cap for the non-positional pool; null = unlimited
  hidden      Boolean  @default(false)
  gcalEventId String?
  legacyKey   String?  @unique // "game-<id>" / "event-<id>" from the old MySQL portal
  workflowStatus EventWorkflowStatus @default(APPROVED)
  tierId      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  kind      EventKind       @relation(fields: [kindId], references: [id])
  tier      EventTier?      @relation(fields: [tierId], references: [id])
  positions EventPosition[]
  runNumbers RunNumber[]
  signups   EventSignup[]
  availabilityResponses EventAvailability[]
  coverageRequest        CoverageRequest?

  @@index([startsAt])
}

model EventPosition {
  id                    Int    @id @default(autoincrement())
  eventId               Int
  position              String // cc, driver, attendant, observer, ees, ...
  /// How many are wanted. Null means no limit — take everyone who signs up.
  count                 Int?
  requiredCredentialKey String? // CredentialType.key gate; null = open

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, position])
}

model EventSignup {
  id       Int     @id @default(autoincrement())
  eventId  Int
  memberId Int
  position String? // null = plain attendee (counted against attendeeCap)
  createdAt DateTime @default(now())

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
}

/** "I can work this" responses gathered during AVAILABILITY_REQUESTED. */
model EventAvailability {
  eventId   Int
  memberId  Int
  positions String[] // positions the member offers to fill
  note      String?
  createdAt DateTime @default(now())

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([eventId, memberId])
}

// Public coverage intake: outside requesters get a tokenized status link.
model CoverageRequest {
  id             Int       @id @default(autoincrement())
  token          String    @unique
  requesterName  String
  requesterOrg   String?
  requesterEmail String
  requesterPhone String?
  description    String
  requestedDate  DateTime? @db.Date
  location       String?
  createdAt      DateTime  @default(now())
  /// Set when a request is turned down before any event exists for it.
  declinedAt     DateTime?
  declineReason  String?
  eventId        Int?      @unique

  event    Event?            @relation(fields: [eventId], references: [id])
  messages CoverageMessage[]
}

enum MessageDirection {
  FROM_REQUESTER
  TO_REQUESTER
}

model CoverageMessage {
  id        Int              @id @default(autoincrement())
  requestId Int
  direction MessageDirection
  body      String
  authorId  Int? // staff member for TO_REQUESTER
  createdAt DateTime         @default(now())

  request CoverageRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  Member?         @relation(fields: [authorId], references: [id])
}

// ---------------------------------------------------------------------------
// Annual trainings & classes
// ---------------------------------------------------------------------------

model AnnualTrainingRequirement {
  id               Int     @id @default(autoincrement())
  name             String
  year             Int
  alertOnLapse     Boolean @default(true) // per-training toggle: alert officers when a member lapses
  blocksScheduling Boolean @default(false) // outstanding completion blocks night-crew signup
  active           Boolean @default(true)

  completions MemberAnnualTraining[]

  @@unique([name, year])
}

model MemberAnnualTraining {
  requirementId Int
  memberId      Int
  completedAt   DateTime?

  requirement AnnualTrainingRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  member      Member                    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([requirementId, memberId])
}

model TrainingClass {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  sessionAt   DateTime?
  location    String?

  attendance             ClassAttendance[]
  credentialRequirements CredentialRequirement[]
  requirementAdjustments PromotionRequirementAdjustment[]
}

enum AttendanceStatus {
  REGISTERED
  ATTENDED
  COMPLETED
  NO_SHOW
}

model ClassAttendance {
  classId  Int
  memberId Int
  status   AttendanceStatus @default(REGISTERED)

  class  TrainingClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  member Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([classId, memberId])
}

// ---------------------------------------------------------------------------
// Ops logs
// ---------------------------------------------------------------------------

model Vehicle {
  id     Int     @id @default(autoincrement())
  name   String  @unique // e.g. "A-1", "Fly Car"
  make   String?
  model  String?
  year   Int?
  plate  String?
  vin    String?
  notes  String?
  active Boolean @default(true)

  fuelEntries FuelLogEntry[]
  asset       Asset?
}

model FuelLogEntry {
  id        Int      @id @default(autoincrement())
  loggedAt  DateTime
  memberId  Int
  vehicle   String // display label (kept for legacy-migrated rows)
  vehicleId Int?
  amount    Decimal  @db.Decimal(6, 2)
  mileage   Int

  member     Member   @relation(fields: [memberId], references: [id])
  vehicleRef Vehicle? @relation(fields: [vehicleId], references: [id])
}

model Radio {
  id          Int     @id @default(autoincrement())
  number      String  @unique
  model       String?
  serial      String?
  accessories Json? // charger, tac mic, extra battery, ...
  retired     Boolean @default(false)

  assignments RadioAssignment[]
}

model RadioAssignment {
  id         Int       @id @default(autoincrement())
  radioId    Int
  memberId   Int
  issuedAt   DateTime  @default(now())
  returnedAt DateTime?

  radio  Radio  @relation(fields: [radioId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id])

  @@index([radioId])
  @@index([memberId])
}

// Parsed text-message dispatches ingested from Herald (techinems/herald).
model Dispatch {
  id             Int      @id @default(autoincrement())
  receivedAt     DateTime @default(now())
  determinant    String? // Alpha/Bravo/Charlie/Delta/Echo/Unknown
  complaint      String?
  location       String?
  business       String?
  additionalInfo String?
  crossStreets   String?
  units          String? // e.g. "E59"
  responseAreas  String?
  latitude       Float?
  longitude      Float?
  geocodedPlace  String?
  raw            Json // the full payload as received, for reprocessing

  @@index([receivedAt])
}

// ---------------------------------------------------------------------------
// Tokens & audit
// ---------------------------------------------------------------------------

enum IcsScope {
  MY_SCHEDULE
  MY_SCHEDULE_AND_ALL_EVENTS
}

model IcsToken {
  id        Int      @id @default(autoincrement())
  memberId  Int
  token     String   @unique
  scope     IcsScope
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model ApiToken {
  id          Int       @id @default(autoincrement())
  name        String
  tokenHash   String    @unique // sha256 of the secret (prefix rpa_); plaintext shown once
  ownerId     Int
  permissions String[] // explicit subset of the permission catalog
  expiresAt   DateTime?
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  owner Member @relation(fields: [ownerId], references: [id])
}

enum ActorType {
  MEMBER
  API_TOKEN
  SYSTEM
}

model AuditLog {
  id        BigInt    @id @default(autoincrement())
  actorType ActorType
  actorId   Int?
  action    String // e.g. credential.appoint, schedule.crews.assign
  entity    String
  entityId  String?
  diff      Json?
  /// Where the request came from, as reported by the proxy in front of the
  /// API. Null for anything not raised by an HTTP request — scheduled jobs,
  /// boot-time work.
  ip        String?
  userAgent String?
  at        DateTime  @default(now())

  @@index([entity, entityId])
  @@index([at])
}

/// Every request the API served, and every page the portals rendered.
///
/// Separate from AuditLog on purpose: that one records decisions somebody
/// made and is meant to be read, while this one records traffic and grows by
/// a row per request. Keeping them apart means a retention sweep here never
/// touches the record of who changed what.
model AccessLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  /// 'API' for a request this service served, 'PAGE' for one of the portals
  /// reporting a page it rendered.
  kind       String   @default("API")
  memberId   Int?
  apiTokenId Int?
  method     String
  path       String
  status     Int?
  durationMs Int?
  ip         String?
  userAgent  String?

  @@index([at])
  @@index([memberId, at])
  @@index([path])
}

/// An outside system asking to be told when something happens here.
///
/// Deliveries are attempted in the background and retried a few times: a
/// webhook that is down must never fail the action that triggered it, and an
/// event worth sending is usually still worth sending a minute later.
model Webhook {
  id          Int      @id @default(autoincrement())
  name        String
  url         String
  /// Event keys this endpoint wants. Empty means every event.
  events      String[]
  /// Signs each delivery so the receiver can tell it really came from here.
  secret      String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  createdById Int?
  /// Set on the last attempt, successful or not, so a dead endpoint is
  /// visible in the console without reading delivery rows.
  lastStatus  Int?
  lastAt      DateTime?
  lastError   String?

  createdBy  Member?             @relation("WebhookCreator", fields: [createdById], references: [id])
  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id         BigInt   @id @default(autoincrement())
  webhookId  Int
  event      String
  payload    Json
  attempts   Int      @default(0)
  status     Int?
  error      String?
  deliveredAt DateTime?
  createdAt  DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
}

enum ChoreCadence {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
}

/// A recurring job somebody has to do — restocking, checking the rig, taking
/// out the rubbish.
///
/// Chores live here rather than in a spreadsheet so completion is part of the
/// record; Slack is where they are announced and claimed, not where they are
/// defined.
model Chore {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  cadence     ChoreCadence @default(WEEKLY)
  /// WEEKLY: 0 = Sunday. MONTHLY: day of the month. Ignored otherwise.
  dayOfWeek   Int?
  dayOfMonth  Int?
  /// Posted to Slack this many days before it is due.
  noticeDays  Int          @default(0)
  active      Boolean      @default(true)
  /// Who it falls to, when it is somebody's job in particular.
  assigneeId  Int?
  createdAt   DateTime     @default(now())

  assignee    Member?          @relation("ChoreAssignee", fields: [assigneeId], references: [id])
  occurrences ChoreOccurrence[]
}

/// One instance of a chore on one day.
model ChoreOccurrence {
  id          Int       @id @default(autoincrement())
  choreId     Int
  dueOn       DateTime  @db.Date
  /// Overrides the chore's standing assignee for this night only, so one
  /// shift can be handed over without disturbing the arrangement behind it.
  /// Null means the chore's own assignee applies.
  assigneeId  Int?
  completedAt DateTime?
  completedById Int?
  /// Whatever the member typed back, from Slack or the portal.
  note        String?
  /// Slack message this was announced in, so the post can be updated in place
  /// when somebody claims it rather than adding another line to the channel.
  slackChannel String?
  slackTs      String?
  postedAt     DateTime?

  chore       Chore   @relation(fields: [choreId], references: [id], onDelete: Cascade)
  assignee    Member? @relation("ChoreOccurrenceAssignee", fields: [assigneeId], references: [id])
  completedBy Member? @relation("ChoreCompleter", fields: [completedById], references: [id])

  @@unique([choreId, dueOn])
  @@index([dueOn])
}

/// A place standbys happen, and its slice of the run-number sequence.
///
/// Ported from strng: run numbers read <LOC>-<DIV><YY><NNN>, e.g. DCC-S25001.
/// Each location counts independently, so the next number is held per
/// location rather than globally.
model RunNumberLocation {
  id      Int     @id @default(autoincrement())
  name    String
  abbr    String  @unique
  active  Boolean @default(true)
  /// The number the next run at this location will take.
  nextRun Int     @default(1)

  runNumbers RunNumber[]
}

/// One issued run number.
///
/// strng kept only a counter, so a number on a report could not be traced
/// back to anything. Every issue is recorded here instead: who took it, when,
/// and what for.
model RunNumber {
  id         Int      @id @default(autoincrement())
  number     String   @unique
  locationId Int
  /// The academic-term division letter this number was issued under.
  division   String
  /// Two digits, matching the number itself.
  year       String
  sequence   Int
  note       String?
  eventId    Int?
  issuedById Int?
  issuedAt   DateTime @default(now())

  location RunNumberLocation @relation(fields: [locationId], references: [id])
  event    Event?            @relation(fields: [eventId], references: [id])
  issuedBy Member?           @relation("RunNumberIssuer", fields: [issuedById], references: [id])

  @@index([issuedAt])
  @@index([locationId, sequence])
}

/**
 * A link worth keeping where everyone can find it — protocols, the county
 * radio plan, the shift-swap spreadsheet. Deliberately just a title and an
 * address: a page that tries to be a document store ends up neither.
 */
model Resource {
  id          Int      @id @default(autoincrement())
  title       String
  url         String
  description String?
  /// Lower sorts first; ties fall back to title.
  position    Int      @default(0)
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy Member? @relation("ResourceCreator", fields: [createdById], references: [id])

  @@index([position])
}

// ------------------------------------------------------------- checksheets

/// How an item is counted.
enum ChecksheetItemKind {
  /// There or not there: one button, pressed or not.
  PRESENCE
  /// A par level with a count of how many are actually there.
  PAR
}

/// Whether an item's expiry dates are logged, and how many of them.
enum ExpiryTracking {
  NONE
  /// One date for the item, whatever its count.
  SINGLE
  /// One date per unit the par level calls for, so a box of four gives four.
  PER_UNIT
}

enum ChecksheetCadence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

/// A category of thing that gets checked: ambulance, first aid bag, AED.
model AssetKind {
  id        Int                  @id @default(autoincrement())
  name      String               @unique
  active    Boolean              @default(true)
  assets    Asset[]
  templates ChecksheetTemplate[]
}

/// A particular thing that gets checked.
///
/// Separate from Vehicle because most of what gets checked is not a vehicle —
/// bags, AEDs, the event trailer — while the ones that are should not be
/// entered twice, hence the optional link.
model Asset {
  id         Int     @id @default(autoincrement())
  name       String
  kindId     Int
  vehicleId  Int?    @unique
  identifier String?
  notes      String?
  active     Boolean @default(true)

  kind         AssetKind              @relation(fields: [kindId], references: [id])
  vehicle      Vehicle?               @relation(fields: [vehicleId], references: [id])
  runs         ChecksheetRun[]
  deficiencies ChecksheetDeficiency[]

  @@unique([kindId, name])
  @@index([active])
}

model ChecksheetTemplate {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  active      Boolean @default(true)
  /// Which kind of thing this is a check for. Null means it stands alone and
  /// runs name no asset — a station sweep rather than a truck.
  assetKindId Int?
  cadence     ChecksheetCadence @default(NONE)
  /// Days ahead of an expiry to start warning. Null uses the agency default.
  expiryWarningDays Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assetKind AssetKind? @relation(fields: [assetKindId], references: [id])
  /// Told when a sheet is completed, and when something on it is expiring.
  notifyRoles Role[]  @relation("ChecksheetNotifyRoles")

  sections     ChecksheetSection[]
  items        ChecksheetItem[]
  runs         ChecksheetRun[]
  deficiencies ChecksheetDeficiency[]
}

model ChecksheetSection {
  id          Int     @id @default(autoincrement())
  templateId  Int
  order       Int
  heading     String
  description String?
  /// Whether this section is kept sealed — a drug box, a sealed bag — so the
  /// person checking reads the seal number rather than opening it.
  hasSeal     Boolean @default(false)

  template ChecksheetTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    ChecksheetItem[]
  entries  ChecksheetSectionEntry[]

  @@index([templateId])
}

/// What was found of one sealed section on one check.
///
/// A seal is how a section is checked without opening it: read the number,
/// confirm it matches, move on. The number is recorded rather than merely
/// confirmed so a seal changing between checks is visible afterwards.
model ChecksheetSectionEntry {
  id        Int     @id @default(autoincrement())
  runId     Int
  sectionId Int
  /// Whether there was a seal on it at all. A section can be configured to
  /// carry a seal and be found without one, which is worth recording rather
  /// than refusing to accept.
  sealPresent Boolean @default(false)
  /// As read off the seal. Optional even when one is present: an unreadable
  /// seal is still a seal, and refusing the sheet over it helps nobody.
  sealNumber  String?
  /// Set when the seal was broken during this check — because something
  /// inside had expired and had to be reached.
  sealBroken  Boolean @default(false)
  note        String?

  run     ChecksheetRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  section ChecksheetSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([runId, sectionId])
  @@index([sectionId])
}

model ChecksheetItem {
  id         Int    @id @default(autoincrement())
  templateId Int
  /// Null = loose at the top of the sheet; otherwise the section it sits in.
  sectionId  Int?
  order      Int
  label      String
  notes      String?
  kind       ChecksheetItemKind @default(PRESENCE)
  /// PAR only: how many there should be.
  parLevel   Int?
  expiryTracking ExpiryTracking @default(NONE)

  template     ChecksheetTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  section      ChecksheetSection?     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  entries      ChecksheetEntry[]
  deficiencies ChecksheetDeficiency[]

  @@index([templateId])
  @@index([sectionId])
}

/// One completed sheet.
model ChecksheetRun {
  id            Int      @id @default(autoincrement())
  templateId    Int
  assetId       Int?
  completedById Int?
  completedAt   DateTime @default(now())
  /// Free text about the check as a whole.
  comment       String?

  template    ChecksheetTemplate     @relation(fields: [templateId], references: [id])
  asset       Asset?                 @relation(fields: [assetId], references: [id])
  completedBy Member?                @relation("ChecksheetCompletedBy", fields: [completedById], references: [id])
  entries       ChecksheetEntry[]
  sectionEntries ChecksheetSectionEntry[]
  opened        ChecksheetDeficiency[] @relation("DeficiencyOpenedBy")
  closed      ChecksheetDeficiency[] @relation("DeficiencyClosedBy")

  @@index([templateId, completedAt])
  @@index([assetId, completedAt])
}

model ChecksheetEntry {
  id     Int  @id @default(autoincrement())
  runId  Int
  itemId Int
  /// PRESENCE items.
  present Boolean?
  /// PAR items: how many were actually found.
  countPresent Int?
  note   String?

  run      ChecksheetRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  item     ChecksheetItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  expiries ChecksheetExpiry[]

  @@unique([runId, itemId])
  @@index([itemId])
}

model ChecksheetExpiry {
  id       Int      @id @default(autoincrement())
  entryId  Int
  /// Which of the par units this date belongs to; 0 for a single date.
  position Int      @default(0)
  expiresAt DateTime @db.Date

  entry ChecksheetEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([expiresAt])
}

/// Something missing or short, from the run that found it until it is fixed.
///
/// Kept out of the run so a shortage survives being found again: the same
/// missing item reported on four nights running is one deficiency with four
/// sightings, not four problems.
model ChecksheetDeficiency {
  id         Int      @id @default(autoincrement())
  templateId Int
  itemId     Int
  assetId    Int?
  openedRunId Int
  openedAt   DateTime @default(now())
  /// What was wrong, in words, at the time — so the record still reads
  /// correctly after somebody edits the item's label or par level.
  detail     String
  expected   Int?
  found      Int?
  /// The most recent run that saw it still outstanding.
  lastSeenAt DateTime @default(now())

  resolvedAt     DateTime?
  resolvedById   Int?
  resolvedRunId  Int?
  resolutionNote String?

  template   ChecksheetTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  item       ChecksheetItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  asset      Asset?             @relation(fields: [assetId], references: [id])
  openedRun  ChecksheetRun      @relation("DeficiencyOpenedBy", fields: [openedRunId], references: [id], onDelete: Cascade)
  resolvedRun ChecksheetRun?    @relation("DeficiencyClosedBy", fields: [resolvedRunId], references: [id])
  resolvedBy Member?            @relation("DeficiencyResolvedBy", fields: [resolvedById], references: [id])

  @@index([resolvedAt])
  @@index([assetId, resolvedAt])
}

/// A Keycloak login with no member record behind it.
///
/// Kept as a row rather than only a notification for two reasons: the auth
/// guard runs on every request, so something has to remember that this
/// person has already been reported, and an officer needs the address and
/// the subject id in front of them to link the account.
model UnlinkedLogin {
  id              Int      @id @default(autoincrement())
  keycloakSubject String   @unique
  email           String?
  name            String?
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  attempts        Int      @default(1)
  /// Set when somebody links it, or when the login stops being unlinked.
  resolvedAt      DateTime?
  resolvedById    Int?
  resolvedMemberId Int?

  resolvedBy Member? @relation("UnlinkedLoginResolver", fields: [resolvedById], references: [id])

  @@index([resolvedAt])
}

enum RequestStatus {
  PENDING
  APPROVED
  DECLINED
}

/// A member asking for one of the fields only an officer can change.
///
/// Name and portal email are locked on the profile page because they are
/// identity — the email is what a login is matched on. Locked is not the
/// same as unchangeable, though, and "email an officer" is a worse process
/// than one that leaves a record.
model ProfileChangeRequest {
  id             Int           @id @default(autoincrement())
  memberId       Int
  field          String
  currentValue   String?
  requestedValue String
  reason         String?
  status         RequestStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  decidedAt      DateTime?
  decidedById    Int?
  decisionNote   String?

  member    Member  @relation("ProfileChangeSubject", fields: [memberId], references: [id], onDelete: Cascade)
  decidedBy Member? @relation("ProfileChangeDecider", fields: [decidedById], references: [id])

  @@index([status])
  @@index([memberId])
}

/// A code that lets somebody outside the agency ask for an account.
///
/// The portal is otherwise closed: there is no self-registration, and this is
/// the controlled way in — handed out at an open house or on a recruiting
/// poster, and closable the moment it has served its purpose.
model InviteCode {
  code        String    @id
  label       String?
  createdById Int?
  createdAt   DateTime  @default(now())
  /// Closed by hand, or by running out of time or uses.
  closedAt    DateTime?
  closedById  Int?
  expiresAt   DateTime?
  maxUses     Int?
  uses        Int       @default(0)

  createdBy Member?          @relation("InviteCodeCreator", fields: [createdById], references: [id])
  closedBy  Member?          @relation("InviteCodeCloser", fields: [closedById], references: [id])
  requests  AccountRequest[]
}

/// Somebody asking to be let in, from the invite-code portal.
model AccountRequest {
  id           Int           @id @default(autoincrement())
  inviteCode   String?
  firstName    String
  lastName     String
  email        String
  phone        String?
  note         String?
  status       RequestStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  decidedAt    DateTime?
  decidedById  Int?
  decisionNote String?
  /// The member created from it, once approved.
  memberId     Int?

  invite    InviteCode? @relation(fields: [inviteCode], references: [code])
  decidedBy Member?     @relation("AccountRequestDecider", fields: [decidedById], references: [id])
  member    Member?     @relation("AccountRequestMember", fields: [memberId], references: [id])

  @@index([status])
}
